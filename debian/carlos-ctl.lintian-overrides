# carlosctl is the deprecated compatibility name for carlos-ctl (renamed to
# match the carlos-podman tool); both resolve to the same binary and the man
# page is carlos-ctl(8).
no-manual-page usr/sbin/carlosctl

# Ubuntu 26.04's man-db exits 3 with this status-only pipeline message for
# compressed manual pages under lintian's `man -l -Tutf8 -Z` invocation; the
# same command also fails for /usr/share/man/man1/ls.1.gz. The package test
# gate separately checks the uncompressed source with groff -ww and explicitly
# fails on any diagnostic (groff warnings normally exit zero), so real roff
# problems remain release failures.
groff-message command exited with status 1: * [usr/share/man/man8/carlos-ctl.8.gz:1]
