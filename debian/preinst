#!/bin/sh
# preinst for carlos-ctl.
#
# Refuse to unpack over a running OSCAR 19 import. The importer
# (`carlos-ctl import-o19`) imports its o19 modules lazily, phase by phase,
# so replacing /usr/lib/carlos-ctl/carlos_ctl/*.py under it -- an upgrade of
# this package, or the FIRST install of it while the copy inside a pre-split
# carlos-emr is mid-import -- would run the rest of the import on a mix of
# two releases. The ledger is /var/lib/carlos-emr/o19-import/state.json and
# the predicate is carlos-emr's own guard, the one its service unit and
# postinst consult (carlos-emr-o19-guard): ONE predicate, so this cannot
# disagree with them. Fails CLOSED: a ledger that exists but cannot be
# judged counts as an import in progress. An inactive, structurally valid
# pre-copy run may install the fixed package while both import locks are
# held until dpkg exits. The importer must then verify the target on resume.
set -e

LEDGER=/var/lib/carlos-emr/o19-import/state.json
GUARD=/usr/lib/carlos-emr/carlos-emr-o19-guard

refuse() {
    echo "carlos-ctl: NOT installing: an OSCAR 19 import is in progress on this host" >&2
    echo "carlos-ctl: (ledger $LEDGER). Replacing the tool under a running import would" >&2
    echo "carlos-ctl: continue it on a mix of two releases. Finish the import with" >&2
    echo "carlos-ctl:   sudo carlos-ctl import-o19 ... --resume" >&2
    echo "carlos-ctl: (or, for a dry run or abandoned assessment: sudo carlos-ctl import-o19 --cleanup)," >&2
    echo "carlos-ctl: then install this package again. Nothing has been changed." >&2
    exit 1
}

case "$1" in
    install|upgrade)
        # -s: the importer writes the ledger with os.replace(), so a 0-byte
        # file is never a written state (the guard treats it the same way).
        if [ -s "$LEDGER" ]; then
            if [ -x "$GUARD" ]; then
                if ! "$GUARD" "$LEDGER" >/dev/null 2>&1; then
                    python3 - "$LEDGER" "$PPID" <<'PRE_COPY_UPGRADE' || refuse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import sys
import time


def stopped_before_copy(directory):
    """Accept only a bound ledger with recognized, well-formed pre-copy phases."""
    state = json.loads((directory / 'state.json').read_text())
    if not isinstance(state, dict) or not isinstance(state.get('phases'), dict):
        return False
    phases = state['phases']
    if (state.get('cleanup')
            or not set(phases) <= {'check-pristine', 'backup', 'stage', 'preflight'}
            or any(not isinstance(entry, dict)
                   or entry.get('status') not in {'done', 'in-progress'}
                   for entry in phases.values())):
        return False
    inputs = state.get('inputs', {})
    if not isinstance(inputs, dict) or not re.fullmatch(r'[0-9a-f]{64}', inputs.get('target_contract_sha256', '')):
        return False
    if not re.fullmatch(r'o19map-\d+\+[0-9a-f]{8}', inputs.get('schema_map_version', '')):
        return False
    progress = directory / 'etl-progress.json'
    if progress.exists():
        data = json.loads(progress.read_text())
        if (not isinstance(data, dict) or not isinstance(data.get('tables'), dict)
                or data['tables'] or data.get('admin_provider_no')):
            return False
    return True


def dpkg_identity(pid):
    """Identify the supervising dpkg instance without trusting a reused PID."""
    directory = Path('/proc') / str(pid)
    if directory.joinpath('comm').read_text().strip() != 'dpkg':
        raise ValueError('recovery must run inside dpkg')
    return directory.joinpath('stat').read_text().split()[21]


def main():
    """Hold regular import lock files until the supervising dpkg exits."""
    directory = Path(sys.argv[1]).parent
    pid = int(sys.argv[2])
    identity = dpkg_identity(pid)
    # Same lock order as import-o19. Keep both through unpack/configure,
    # not merely until preinst returns: a new importer must not start in
    # the gap between checking the ledger and replacing lazy-loaded files.
    with contextlib.ExitStack() as stack:
        for path, mode in ((directory.parent / '.finish-install.lock', 0o644),
                           (directory / '.lock', 0o600)):
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW
                         | os.O_NONBLOCK, mode)
            stack.callback(os.close, fd)
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise ValueError('import lock must be a regular file: ' + str(path))
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if not stopped_before_copy(directory):
            return 1
        if os.fork() == 0:
            os.setsid()
            null = os.open('/dev/null', os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(null, fd)
            if null > 2:
                os.close(null)
            try:
                while dpkg_identity(pid) == identity:
                    time.sleep(1)
            except (OSError, ValueError, IndexError):
                pass
            os._exit(0)
        print('carlos-ctl: allowing package recovery before the first ETL write; '
              'the application remains guarded and --resume must verify the target.', file=sys.stderr)
        return 0



if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, TypeError, IndexError):
        sys.exit(1)
PRE_COPY_UPGRADE
                fi
            else
                # a ledger with nothing on the host able to judge it: closed
                echo "carlos-ctl: $GUARD is missing, so the import ledger cannot be judged." >&2
                refuse
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
