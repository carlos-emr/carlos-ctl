#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 CARLOS Contributors
# Shim for the carlos_ctl Python package — same shape as carlos-podman's
# /usr/local/sbin/carlos-ctl shim. Everything real lives in
# /usr/lib/carlos-ctl/carlos_ctl/ (the carlos-ctl package; the application
# it administers is carlos-emr, under /usr/lib/carlos-emr and
# /usr/share/carlos-emr).
export PYTHONPATH="/usr/lib/carlos-ctl${PYTHONPATH:+:${PYTHONPATH}}"
# No bytecode cache: the tool runs as root, and a __pycache__ written under
# a dpkg-owned directory is a file no package owns -- it survived every
# upgrade and removal of the old in-carlos-emr copy. Start-up cost is a
# few milliseconds of compile for an interactive administration command.
export PYTHONDONTWRITEBYTECODE=1
# The invoked NAME survives into the Python side via the environment:
# `python3 -m` replaces sys.argv[0] with the module path, so the deprecation
# note for the old `carlosctl` spelling cannot be detected from argv.
CARLOS_CTL_INVOKED_AS="${0##*/}" exec python3 -m carlos_ctl.cli "$@"
